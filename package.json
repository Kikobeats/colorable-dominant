{
  "name": "colorable-dominant",
  "description": "Build ARIA and WCAG-compliant color themes from a predominant palette with contrast-safe pairs.",
  "homepage": "https://github.com/Kikobeats/colorable-dominant",
  "version": "1.1.16",
  "main": "src/index.js",
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikobeats/colorable-dominant.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/colorable-dominant/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "aria",
    "color",
    "colorable",
    "contrast",
    "dominant",
    "palette",
    "theme",
    "wcag"
  ],
  "dependencies": {
    "color": "~4.2.0",
    "colorable": "~1.0.5",
    "normalize-value": "~1.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "c8": "latest",
    "ci-publish": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "mocha": "latest",
    "nano-staged": "latest",
    "should": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">= 6"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "contributors": "(npx git-authors-cli && npx finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "lint": "standard",
    "postrelease": "npm run release:tags && npm run release:github && (ci-publish || npm publish --access=public)",
    "prerelease": "npm run contributors",
    "pretest": "npm run lint",
    "pretty": "prettier-standard index.js {core,test,bin}/**/*.js --single-quote",
    "release": "standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin HEAD:master",
    "test": "c8 mocha"
  },
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "npx @kikobeats/prettier-standard",
      "standard --fix"
    ],
    "package.json": [
      "finepack"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  },
  "standard": {
    "env": [
      "mocha"
    ]
  }
}
